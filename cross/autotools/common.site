# Shared part of the autotools CONFIG_SITE files (amd64.site, arm64.site).
#
# Expects in the environment (exported by build-xlibs.sh):
#   SYSROOT       the staged NextBSD base, with earlier components in /usr/X11
#   CROSS_BINDIR  the toolchain image's pinned clang/lld 19.1.7
#   XLIBS_CROSS   this directory's parent (cross/)
# and xlibs_triple from the per-arch file that sources this one.

: "${SYSROOT:?}" "${CROSS_BINDIR:?}" "${xlibs_triple:?}"

# The cross compiler. -fuse-ld=lld is part of CC/CXX, not LDFLAGS: older
# bundled libtool (e.g. gmp's, libao's) drops it from LDFLAGS on link lines,
# so arm64 then links with the runner's x86 ld and amd64 silently with GNU ld.
# clang finds ld.lld beside itself; the flag is ignored when only compiling.
CC="$CROSS_BINDIR/clang --target=$xlibs_triple --sysroot=$SYSROOT -fuse-ld=lld"
CXX="$CROSS_BINDIR/clang++ --target=$xlibs_triple --sysroot=$SYSROOT -fuse-ld=lld"
CFLAGS="${CFLAGS:--O2 -pipe}"
CXXFLAGS="${CXXFLAGS:--O2 -pipe}"
LDFLAGS="${LDFLAGS:-}"
AR="$CROSS_BINDIR/llvm-ar"
RANLIB="$CROSS_BINDIR/llvm-ranlib"
NM="$CROSS_BINDIR/llvm-nm"
STRIP="$CROSS_BINDIR/llvm-strip"
OBJCOPY="$CROSS_BINDIR/llvm-objcopy"

# Programs that run on the build host during the build (libX11's makekeys,
# libXt's makestrs) use the host compiler. They include the X protocol headers
# (X11/X.h, X11/keysymdef.h), which are architecture-independent, so they are
# taken from the sysroot's /usr/X11/include: only X headers live there, never
# the target's libc headers.
CC_FOR_BUILD=cc
CPPFLAGS_FOR_BUILD="-I$SYSROOT/usr/X11/include"

# pkgconf (ISC), never freedesktop's GPL pkg-config. Only the sysroot's .pc
# directories are searched, and -I/-L results are prefixed with the sysroot.
PKG_CONFIG=pkgconf
PKG_CONFIG_LIBDIR="$SYSROOT/usr/X11/lib/pkgconfig:$SYSROOT/usr/libdata/pkgconfig"
PKG_CONFIG_SYSROOT_DIR="$SYSROOT"
export PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR

# Cache answers for checks that must run a target program, common to both
# arches. Each needs a reason, e.g.:
#   name_cv_check=value   # why this is the NextBSD answer
